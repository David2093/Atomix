# Server-only session secret. Generate a long random value for deployments.
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/atomix.sqlite

# Optional SMTP delivery for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ATOMIX <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:5500

# Optional frontend origin when frontend and API are deployed separately.
FRONTEND_ORIGIN=
